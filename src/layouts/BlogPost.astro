---
import Layout from './Layout.astro';
import { formatDate } from '../utils/date';
import type { CollectionEntry } from 'astro:content';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import SidebarNewsletter from '../components/SidebarNewsletter.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date;
      updatedDate?: Date;
      coverImage?: string;
      author?: {
        name: string;
        image?: string;
        id?: string;
      };
      tags?: string[];
    };
    body?: string;
  };
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, coverImage, author, tags } = post.data;

// Ensure author has default values if not provided
const authorName = author?.name || 'Playable Data Team';
const authorImage = author?.image || '/images/default-avatar.svg';

// Prepare article data for dataLayer
const articleData = {
  slug: post.slug,
  title,
  author: {
    name: authorName,
    id: author?.id
  },
  tags,
  pubDate
};

// Prepare metadata for the Layout component
const metaData = {
  title,
  description,
  image: coverImage,
  type: 'article',
  publishDate: pubDate,
  modifiedDate: updatedDate
};

// Generate structured data for the article
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": coverImage ? [coverImage] : [],
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": authorName,
    ...(author?.id && {"identifier": author.id})
  },
  "publisher": {
    "@type": "Organization",
    "name": "Playable Data",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/images/logo.png", Astro.url).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  "keywords": tags?.join(", ") || "game analytics, gaming data"
};

// Calculate estimated reading time based on word count (~200 words per minute)
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Format date for display
const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
---

<Layout 
  title={title} 
  description={description} 
  image={coverImage} 
  type="article" 
  publishDate={pubDate} 
  modifiedDate={updatedDate}
>
  <!-- Add structured data specifically for this article -->
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  
  <!-- Add GTM article tracking -->
  <script is:inline define:vars={{ articleData, title, description, publishDate: pubDate, modifiedDate: updatedDate, canonicalUrl: Astro.url.href, tags, authorName, coverImage, readingTime, wordCount }}>
    window.dataLayer = window.dataLayer || [];
    
    // Enhanced article tracking for SEO analytics
    dataLayer.push({
      event: 'articleView',
      articleData: {
        title: articleData.title,
        id: articleData.slug,
        author: articleData.author.name,
        authorId: articleData.author.id || null,
        tags: articleData.tags || [],
        publishDate: articleData.pubDate ? new Date(articleData.pubDate).toISOString() : '',
        hasImage: !!coverImage,
        wordCount: wordCount,
        estimatedReadTime: readingTime,
        hasUpdates: !!modifiedDate,
        hasStructuredData: true
      },
      seoData: {
        hasTags: (tags || []).length > 0,
        tagCount: (tags || []).length,
        hasDescription: !!description,
        descriptionLength: description?.length || 0,
        titleLength: title?.length || 0,
        canonicalUrl: canonicalUrl
      }
    });

    // Track content engagement metrics
    document.addEventListener('DOMContentLoaded', function() {
      const article = document.querySelector('article');
      if (!article) return;
      
      // Track scroll depth
      const scrollDepths = [25, 50, 75, 100];
      let trackedDepths = [];
      
      function calculateScrollDepth() {
        const articleTop = article.getBoundingClientRect().top;
        const articleHeight = article.offsetHeight;
        const windowHeight = window.innerHeight;
        const scrollY = window.scrollY;
        
        // Calculate how much of the article has been viewed
        const articleScrolled = (windowHeight - articleTop) / articleHeight * 100;
        const scrollPercentage = Math.min(100, Math.max(0, Math.round(articleScrolled)));
        
        scrollDepths.forEach(depth => {
          if (scrollPercentage >= depth && !trackedDepths.includes(depth)) {
            trackedDepths.push(depth);
            dataLayer.push({
              event: 'scrollDepth',
              scrollDepthValue: depth,
              articleId: articleData.slug
            });
          }
        });
      }
      
      // Track time on article
      const startTime = new Date();
      const timeIntervals = [10, 30, 60, 120, 300]; // in seconds
      let trackedIntervals = [];
      
      function trackTimeOnArticle() {
        const secondsOnPage = Math.floor((new Date() - startTime) / 1000);
        
        timeIntervals.forEach(interval => {
          if (secondsOnPage >= interval && !trackedIntervals.includes(interval)) {
            trackedIntervals.push(interval);
            dataLayer.push({
              event: 'timeOnArticle',
              timeOnArticleValue: interval,
              articleId: articleData.slug
            });
          }
        });
      }
      
      // Track user interactions with article
      function trackInteraction(eventType, element) {
        dataLayer.push({
          event: 'articleInteraction',
          interactionType: eventType,
          articleId: articleData.slug,
          elementType: element.tagName.toLowerCase(),
          elementText: element.textContent?.substring(0, 50) || ''
        });
      }
      
      // Track clicks within the article
      article.addEventListener('click', function(e) {
        if (e.target.tagName === 'A' || e.target.closest('a')) {
          trackInteraction('link_click', e.target.tagName === 'A' ? e.target : e.target.closest('a'));
        } else if (e.target.tagName === 'BUTTON' || e.target.closest('button')) {
          trackInteraction('button_click', e.target.tagName === 'BUTTON' ? e.target : e.target.closest('button'));
        }
      });
      
      // Setup event listeners
      window.addEventListener('scroll', calculateScrollDepth);
      setInterval(trackTimeOnArticle, 5000);
      
      // Track copy events (e.g., user copying text for sharing/quoting)
      document.addEventListener('copy', function() {
        dataLayer.push({
          event: 'articleInteraction',
          interactionType: 'text_copy',
          articleId: articleData.slug
        });
      });
    });
  </script>

  <!-- Article header section with proper semantic markup -->
  <article class="bg-white min-h-screen">
    <!-- Hero section with cover image if available -->
    {coverImage && (
      <div class="relative w-full aspect-video max-h-[500px] overflow-hidden">
        <OptimizedImage 
          src={coverImage} 
          alt={`Cover image for ${title}`}
          class="w-full h-full object-cover"
          loading="eager"
          width={1200}
          height={630}
        />
      </div>
    )}
    
    <div class="container-custom py-8 md:py-12">
      <header class="mb-8">
        <!-- Article title with proper heading hierarchy -->
        <h1 class="text-3xl md:text-4xl font-bold text-black mb-4">{title}</h1>
        
        <!-- Article metadata with proper semantic markup -->
        <div class="flex flex-wrap items-center text-gray-600 mb-6 gap-2 md:gap-4">
          <!-- Author information with structured microdata -->
          <div class="flex items-center" itemprop="author" itemscope itemtype="https://schema.org/Person">
            {authorImage && (
              <img 
                src={authorImage} 
                alt={`Avatar for ${authorName}`} 
                class="w-10 h-10 rounded-full mr-3 object-cover"
                itemprop="image"
                loading="eager"
                width="40"
                height="40"
              />
            )}
            <span itemprop="name" class="font-medium">{authorName}</span>
          </div>
          
          <span class="w-1.5 h-1.5 rounded-full bg-gray-400" aria-hidden="true"></span>
          
          <!-- Publication date with machine-readable time -->
          <time datetime={pubDate.toISOString()} itemprop="datePublished">
            {formattedPubDate}
          </time>
          
          {updatedDate && (
            <>
              <span class="w-1.5 h-1.5 rounded-full bg-gray-400" aria-hidden="true"></span>
              <span class="text-sm">
                Updated: <time datetime={updatedDate.toISOString()} itemprop="dateModified">
                  {formattedUpdatedDate}
                </time>
              </span>
            </>
          )}
          
          <span class="w-1.5 h-1.5 rounded-full bg-gray-400" aria-hidden="true"></span>
          
          <!-- Reading time estimate -->
          <span class="text-sm">{readingTime} min read</span>
        </div>
        
        <!-- Article tags with proper semantic markup -->
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {tags.map(tag => (
              <a 
                href={`/topics/${tag.toLowerCase()}/`} 
                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-accent/10 text-accent hover:bg-accent/20 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>
      
      <!-- Main article content with proper semantic markup -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Article content in main element -->
        <main class="lg:col-span-8 prose prose-lg max-w-none prose-headings:font-bold prose-a:text-accent" itemprop="articleBody">
          <slot />
        </main>
        
        <!-- Article sidebar with related content -->
        <aside class="lg:col-span-4">
          <SidebarNewsletter />
        </aside>
      </div>
    </div>
  </article>
  
  <!-- Newsletter signup section -->
  <section class="bg-gradient-to-r from-primary to-primary-dark py-16">
    <NewsletterSignup />
  </section>
</Layout>