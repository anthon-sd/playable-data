---
import Layout from './Layout.astro';
import { formatDate } from '../utils/date';
import type { CollectionEntry } from 'astro:content';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import SidebarNewsletter from '../components/SidebarNewsletter.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date;
      updatedDate?: Date;
      coverImage?: string;
      author?: {
        name: string;
        image?: string;
        id?: string;
      };
      tags?: string[];
    };
    body?: string;
  };
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, coverImage, author, tags } = post.data;

// Ensure author has default values if not provided
const authorName = author?.name || 'Playable Data Team';
const authorImage = author?.image || '/images/default-avatar.svg';

// Prepare article data for dataLayer
const articleData = {
  slug: post.slug,
  title,
  author: {
    name: authorName,
    id: author?.id
  },
  tags,
  pubDate
};

// Prepare metadata for the Layout component
const metaData = {
  title,
  description,
  image: coverImage,
  type: 'article',
  publishDate: pubDate,
  modifiedDate: updatedDate
};

// Generate structured data for the article
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": coverImage ? [coverImage] : [],
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": authorName,
    ...(author?.id && {"identifier": author.id})
  },
  "publisher": {
    "@type": "Organization",
    "name": "Playable Data",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/images/logo.png", Astro.url).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  "keywords": tags?.join(", ") || "game analytics, gaming data"
};

// Calculate estimated reading time based on word count (~200 words per minute)
const wordCount = post.body?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Format date for display
const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
---

<Layout 
  title={title} 
  description={description} 
  image={coverImage} 
  type="article" 
  publishDate={pubDate} 
  modifiedDate={updatedDate}
>
  <!-- Add structured data specifically for this article -->
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  
  <!-- Add GTM article tracking -->
  <script is:inline define:vars={{ articleData, title, description, publishDate: pubDate, modifiedDate: updatedDate, canonicalUrl: Astro.url.href, tags, authorName, coverImage, readingTime, wordCount }}>
    window.dataLayer = window.dataLayer || [];
    
    // Enhanced article tracking for SEO analytics
    dataLayer.push({
      event: 'articleView',
      articleData: {
        title: articleData.title,
        id: articleData.slug,
        author: articleData.author.name,
        authorId: articleData.author.id || null,
        tags: articleData.tags || [],
        publishDate: articleData.pubDate ? new Date(articleData.pubDate).toISOString() : '',
        hasImage: !!coverImage,
        wordCount: wordCount,
        estimatedReadTime: readingTime,
        hasUpdates: !!modifiedDate,
        hasStructuredData: true
      },
      seoData: {
        hasTags: (tags || []).length > 0,
        tagCount: (tags || []).length,
        hasDescription: !!description,
        descriptionLength: description?.length || 0,
        titleLength: title?.length || 0,
        canonicalUrl: canonicalUrl
      }
    });

    // Track content engagement metrics
    document.addEventListener('DOMContentLoaded', function() {
      const article = document.querySelector('article');
      if (!article) return;
      
      // Track scroll depth
      const scrollDepths = [25, 50, 75, 100];
      let trackedDepths = [];
      
      function calculateScrollDepth() {
        const articleTop = article.getBoundingClientRect().top;
        const articleHeight = article.offsetHeight;
        const windowHeight = window.innerHeight;
        const scrollY = window.scrollY;
        
        // Calculate how much of the article has been viewed
        const articleScrolled = (windowHeight - articleTop) / articleHeight * 100;
        const scrollPercentage = Math.min(100, Math.max(0, Math.round(articleScrolled)));
        
        scrollDepths.forEach(depth => {
          if (scrollPercentage >= depth && !trackedDepths.includes(depth)) {
            trackedDepths.push(depth);
            dataLayer.push({
              event: 'scrollDepth',
              scrollDepthValue: depth,
              articleId: articleData.slug
            });
          }
        });
      }
      
      // Track time on article
      const startTime = new Date();
      const timeIntervals = [10, 30, 60, 120, 300]; // in seconds
      let trackedIntervals = [];
      
      function trackTimeOnArticle() {
        const secondsOnPage = Math.floor((new Date() - startTime) / 1000);
        
        timeIntervals.forEach(interval => {
          if (secondsOnPage >= interval && !trackedIntervals.includes(interval)) {
            trackedIntervals.push(interval);
            dataLayer.push({
              event: 'timeOnArticle',
              timeOnArticleValue: interval,
              articleId: articleData.slug
            });
          }
        });
      }
      
      // Track user interactions with article
      function trackInteraction(eventType, element) {
        dataLayer.push({
          event: 'articleInteraction',
          interactionType: eventType,
          articleId: articleData.slug,
          elementType: element.tagName.toLowerCase(),
          elementText: element.textContent?.substring(0, 50) || ''
        });
      }
      
      // Track clicks within the article
      article.addEventListener('click', function(e) {
        if (e.target.tagName === 'A' || e.target.closest('a')) {
          trackInteraction('link_click', e.target.tagName === 'A' ? e.target : e.target.closest('a'));
        } else if (e.target.tagName === 'BUTTON' || e.target.closest('button')) {
          trackInteraction('button_click', e.target.tagName === 'BUTTON' ? e.target : e.target.closest('button'));
        }
      });
      
      // Setup event listeners
      window.addEventListener('scroll', calculateScrollDepth);
      setInterval(trackTimeOnArticle, 5000);
      
      // Track copy events (e.g., user copying text for sharing/quoting)
      document.addEventListener('copy', function() {
        dataLayer.push({
          event: 'articleInteraction',
          interactionType: 'text_copy',
          articleId: articleData.slug
        });
      });
    });
  </script>

  <!-- Article header section with proper semantic markup -->
  <article class="bg-white min-h-screen">
    <!-- Hero section with cover image if available -->
    {coverImage && (
      <div class="relative w-full max-w-5xl mx-auto overflow-hidden mb-6 pt-8">
        <div class="rounded-lg overflow-hidden shadow-md px-4 md:px-0">
          <OptimizedImage 
            src={coverImage} 
            alt={`Cover image for ${title}`}
            class="w-full h-auto object-cover"
            loading="eager"
            width={1200}
            height={630}
            aspectRatio="16/9"
          />
        </div>
      </div>
    )}
    
    <div class="container-custom py-8 md:py-12">
      <header class="mb-8">
        <!-- Article title with proper heading hierarchy -->
        <h1 class="text-3xl md:text-4xl font-bold text-black mb-4">{title}</h1>
        
        <!-- Article metadata with proper semantic markup -->
        <div class="flex flex-col gap-2 md:gap-3 mb-6">
          <!-- Author information with structured microdata -->
          <div class="flex items-center" itemprop="author" itemscope itemtype="https://schema.org/Person">
            {authorImage && (
              <img 
                src={authorImage} 
                alt={`Avatar for ${authorName}`} 
                class="w-8 h-8 md:w-10 md:h-10 rounded-full mr-2 md:mr-3 object-cover"
                itemprop="image"
                loading="eager"
                width="40"
                height="40"
              />
            )}
            <span itemprop="name" class="font-medium text-sm md:text-base">{authorName}</span>
          </div>
          
          <!-- Date and read time info -->
          <div class="flex items-center text-gray-600 text-sm gap-2 md:gap-4">
            {updatedDate ? (
              <>
                <span>
                  Updated: <time datetime={updatedDate.toISOString()} itemprop="dateModified">
                    {formattedUpdatedDate}
                  </time>
                </span>
              </>
            ) : (
              <time datetime={pubDate.toISOString()} itemprop="datePublished">
                {formattedPubDate}
              </time>
            )}
            
            <span class="text-gray-400">•</span>
            
            <!-- Reading time estimate -->
            <span>{readingTime} min read</span>
          </div>
        </div>
        
        <!-- Article tags with proper semantic markup -->
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-2">
            {tags.map(tag => (
              <a 
                href={`/topics/${tag.toLowerCase()}/`} 
                class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>
      
      <!-- Main article content with proper semantic markup -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Article content in main element -->
        <main class="lg:col-span-8 prose prose-lg max-w-none prose-headings:font-bold prose-a:text-accent article-content" itemprop="articleBody">
          <slot />
          
          <!-- Social sharing section -->
          <div class="mt-12 pt-6 border-t border-gray-200 not-prose">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Share this article</h3>
            <div class="flex flex-wrap gap-3">
              <!-- Twitter sharing -->
              <a 
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center px-4 py-2 rounded-md bg-[#1DA1F2]/10 text-[#1DA1F2] hover:bg-[#1DA1F2]/20 transition-colors"
                aria-label="Share on Twitter"
              >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                </svg>
                <span>Twitter</span>
              </a>
              
              <!-- LinkedIn sharing -->
              <a 
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center px-4 py-2 rounded-md bg-[#0077B5]/10 text-[#0077B5] hover:bg-[#0077B5]/20 transition-colors"
                aria-label="Share on LinkedIn"
              >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
                <span>LinkedIn</span>
              </a>
              
              <!-- WhatsApp sharing -->
              <a 
                href={`https://wa.me/?text=${encodeURIComponent(`${title} ${Astro.url.href}`)}`}
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center px-4 py-2 rounded-md bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366]/20 transition-colors"
                aria-label="Share on WhatsApp"
              >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>WhatsApp</span>
              </a>
              
              <!-- Email sharing -->
              <a 
                href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`I thought you might be interested in this article: ${Astro.url.href}`)}`}
                class="inline-flex items-center px-4 py-2 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
                aria-label="Share via Email"
              >
                <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>Email</span>
              </a>
              
              <!-- Copy link button -->
              <button 
                id="copy-link-button"
                class="inline-flex items-center px-4 py-2 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors"
                aria-label="Copy link to clipboard"
              >
                <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span>Copy Link</span>
              </button>
            </div>
          </div>
          
          <!-- Copy link functionality -->
          <script is:inline>
            document.addEventListener('DOMContentLoaded', function() {
              const copyLinkButton = document.getElementById('copy-link-button');
              if (copyLinkButton) {
                copyLinkButton.addEventListener('click', function() {
                  // Copy the URL to clipboard
                  navigator.clipboard.writeText(window.location.href)
                    .then(() => {
                      // Change button text temporarily to show success
                      const originalText = copyLinkButton.innerHTML;
                      copyLinkButton.innerHTML = `
                        <svg class="w-5 h-5 mr-2 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Copied!</span>
                      `;
                      copyLinkButton.classList.add('bg-green-50', 'text-green-700');
                      
                      // Track copy event in dataLayer
                      if (window.dataLayer) {
                        window.dataLayer.push({
                          event: 'share',
                          method: 'copy_link',
                          content_type: 'article',
                          item_id: document.location.pathname.split('/').filter(Boolean).pop()
                        });
                      }
                      
                      // Reset button after 2 seconds
                      setTimeout(() => {
                        copyLinkButton.innerHTML = originalText;
                        copyLinkButton.classList.remove('bg-green-50', 'text-green-700');
                      }, 2000);
                    })
                    .catch(err => {
                      console.error('Failed to copy link: ', err);
                      // Show error feedback
                      const originalText = copyLinkButton.innerHTML;
                      copyLinkButton.innerHTML = `
                        <svg class="w-5 h-5 mr-2 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        <span>Error!</span>
                      `;
                      
                      // Reset button after 2 seconds
                      setTimeout(() => {
                        copyLinkButton.innerHTML = originalText;
                      }, 2000);
                    });
                });
              }
            });
          </script>
        </main>
        
        <!-- Article sidebar with related content -->
        <aside class="lg:col-span-4">
          <SidebarNewsletter />
        </aside>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Match in-article images to cover image size */
  .article-content :global(figure),
  .article-content :global(img) {
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }
  
  .article-content :global(figure img) {
    margin-top: 0;
    margin-bottom: 0;
  }
  
  /* For larger screen sizes, limit the maximum width to match the cover image */
  @media (min-width: 768px) {
    .article-content :global(figure),
    .article-content :global(img) {
      max-width: min(100%, 64rem); /* 64rem is equivalent to max-w-5xl */
      border-radius: 0.5rem;
    }
  }
</style>