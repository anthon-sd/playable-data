<div class="bg-black text-white py-16">
  <div class="container-custom">
    <div class="lg:flex lg:items-center lg:justify-center">
      <div class="lg:max-w-xl">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-white">
          Stay updated with our latest insights
        </h2>
        <p class="mt-3 text-lg text-accent-lighter">
          Subscribe to our newsletter to receive expert tech insights, industry trends, and exclusive content directly to your inbox.
        </p>
      </div>
      <div class="mt-8 lg:mt-0 lg:ml-8">
        <form id="newsletter-form" class="newsletter-form sm:flex">
          <label for="email-address" class="sr-only">Email address</label>
          <input
            id="email-address"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="input-base w-full px-5 py-3 placeholder-dark-2 focus:ring-accent focus:border-accent sm:max-w-md border-white rounded-md"
            placeholder="Enter your email"
          />
          <div class="mt-3 rounded-md shadow sm:mt-0 sm:ml-3 sm:flex-shrink-0">
            <button
              type="submit"
              class="w-full flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-black bg-[#ffaa0c] hover:bg-opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#ffaa0c]"
            >
              Subscribe
            </button>
          </div>
        </form>
        <div id="newsletter-message" class="mt-3 text-sm" style="display: none;"></div>
        <p class="mt-3 text-sm text-accent-lighter">
          We care about your data. Read our <a href="/privacy-policy" class="font-medium underline">Privacy Policy</a>.
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  import { trackFormSubmission, trackOutboundLink } from '../utils/gtm';
  
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('newsletter-form');
    const messageEl = document.getElementById('newsletter-message');
    
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const email = document.getElementById('email-address').value;
        const submitButton = form.querySelector('button[type="submit"]');
        
        // Disable button and show loading state
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.innerHTML = 'Subscribing...';
        }
        
        try {
          // Track form submission attempt
          trackFormSubmission('newsletter', false, {
            formId: form.id,
            userEmail: email
          });
          
          // Save to Supabase via API endpoint
          const response = await fetch('/api/newsletter-signup', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              email,
              source: 'main_newsletter',
              pageUrl: window.location.href
            })
          });
          
          const result = await response.json();
          
          // Show success/error message
          if (messageEl) {
            messageEl.style.display = 'block';
            
            if (result.success) {
              messageEl.className = 'mt-3 text-sm text-green-400';
            } else {
              messageEl.className = 'mt-3 text-sm text-red-400';
            }
            
            messageEl.textContent = result.message;
          }
          
          // Track form submission result
          trackFormSubmission('newsletter', result.success, {
            formId: form.id,
            userEmail: email
          });
          
          // If success, clear the form
          if (result.success) {
            form.reset();
          }
        } catch (error) {
          console.error('Error submitting newsletter form:', error);
          
          if (messageEl) {
            messageEl.style.display = 'block';
            messageEl.className = 'mt-3 text-sm text-red-400';
            messageEl.textContent = 'An error occurred. Please try again later.';
          }
          
          // Track form submission error
          trackFormSubmission('newsletter', false, {
            formId: form.id,
            error: error.message
          });
        } finally {
          // Re-enable button
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.innerHTML = 'Subscribe';
          }
        }
      });
    }
    
    // Track outbound links
    document.querySelectorAll('a[href^="http"]').forEach(link => {
      link.addEventListener('click', function(e) {
        const url = this.getAttribute('href');
        const linkText = this.textContent;
        const linkContext = this.closest('section')?.id || '';
        
        trackOutboundLink(url, linkText, linkContext);
      });
    });
  });
</script>