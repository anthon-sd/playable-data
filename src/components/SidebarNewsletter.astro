---
// SidebarNewsletter component - A compact newsletter signup for blog post sidebars
---

<div class="sidebar-newsletter bg-black text-white rounded-lg p-6 shadow-md">
  <h3 class="text-xl font-bold text-white mb-3">
    Stay in the loop
  </h3>
  
  <p class="text-sm text-accent-lighter mb-4">
    Get our latest insights and updates delivered straight to your inbox.
  </p>
  
  <form class="newsletter-form" id="sidebar-newsletter-form">
    <label for="sidebar-email" class="sr-only">Email address</label>
    <input
      id="sidebar-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      class="input-base w-full px-4 py-2 text-sm placeholder-dark-2 focus:ring-accent focus:border-accent border-white rounded-md mb-3"
      placeholder="Your email address"
    />
    
    <button
      type="submit"
      class="w-full flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-black bg-[#ffaa0c] hover:bg-opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#ffaa0c]"
    >
      Subscribe
    </button>
  </form>
  
  <div class="sidebar-message mt-3 text-sm" style="display: none;" id="sidebar-newsletter-message"></div>
  
  <p class="mt-3 text-xs text-accent-lighter">
    By subscribing, you agree to our <a href="/privacy-policy" class="font-medium underline">Privacy Policy</a>.
  </p>
</div>

<script is:inline>
  import { trackFormSubmission } from '../utils/gtm';
  
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('sidebar-newsletter-form');
    const messageEl = document.getElementById('sidebar-newsletter-message');
    
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const email = document.getElementById('sidebar-email').value;
        const submitButton = form.querySelector('button[type="submit"]');
        
        // Disable button and show loading state
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.innerHTML = 'Subscribing...';
        }
        
        try {
          // Track form submission attempt
          trackFormSubmission('sidebar_newsletter', false, {
            formId: form.id,
            userEmail: email
          });
          
          // Save to Supabase via API endpoint
          const response = await fetch('/api/newsletter-signup', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              email,
              source: 'sidebar_newsletter',
              pageUrl: window.location.href
            })
          });
          
          const result = await response.json();
          
          // Show success/error message
          if (messageEl) {
            messageEl.style.display = 'block';
            
            if (result.success) {
              messageEl.className = 'mt-3 text-sm text-green-400 sidebar-message';
            } else {
              messageEl.className = 'mt-3 text-sm text-red-400 sidebar-message';
            }
            
            messageEl.textContent = result.message;
          }
          
          // Track form submission result
          trackFormSubmission('sidebar_newsletter', result.success, {
            formId: form.id,
            userEmail: email
          });
          
          // If success, clear the form
          if (result.success) {
            this.reset();
          }
        } catch (error) {
          console.error('Error submitting sidebar newsletter form:', error);
          
          if (messageEl) {
            messageEl.style.display = 'block';
            messageEl.className = 'mt-3 text-sm text-red-400 sidebar-message';
            messageEl.textContent = 'An error occurred. Please try again later.';
          }
          
          // Track form submission error
          trackFormSubmission('sidebar_newsletter', false, {
            formId: form.id,
            error: error.message
          });
        } finally {
          // Re-enable button
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.innerHTML = 'Subscribe';
          }
        }
      });
    }
  });
</script>

<style>
  /* Simple responsive styling */
  @media (max-width: 1023px) {
    .sidebar-newsletter {
      margin-top: 2rem;
      margin-bottom: 2rem;
    }
  }
</style> 