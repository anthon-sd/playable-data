---
import { formatDate } from '../utils/date';
import OptimizedImage from './OptimizedImage.astro';

const { post } = Astro.props;
const { slug, data } = post;
// Convert slug to lowercase to ensure consistent URLs
const lowercaseSlug = slug.toLowerCase();
const { title, description, pubDate, coverImage, author, topics = [], tags = [] } = data;

// Use topics if available, otherwise fall back to tags
const postTopics = topics.length > 0 ? topics : tags;
---

<article class="card card-hover relative overflow-hidden p-0">
  <div class="md:flex">
    {coverImage && (
      <div class="md:flex-shrink-0 md:w-1/2 overflow-hidden">
        <a href={`/blog/${lowercaseSlug}/`} class="block h-48 md:h-full">
          <div class="w-full h-full transition-transform duration-500 hover:scale-105">
            <OptimizedImage 
              src={coverImage} 
              alt={`Cover image for ${title}`} 
              class="w-full h-full object-cover"
              width={800}
              height={600}
              isCritical={true}
            />
          </div>
        </a>
      </div>
    )}
    
    <div class="p-4 md:p-6 md:w-1/2 flex flex-col justify-center">
      <div class="uppercase tracking-wide text-sm text-highlight font-semibold mb-1">Featured Post</div>
      
      {postTopics && postTopics.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-2 md:mb-3">
          {postTopics.slice(0, 3).map((topic: string) => (
            <a href={`/topics/${topic}/`} class="text-xs bg-tint-20 hover:bg-tint-50 text-dark-1 px-2 py-1 rounded-full transition">
              #{topic}
            </a>
          ))}
        </div>
      )}
      
      <h2 class="text-xl md:text-2xl font-bold mb-2 md:mb-3 text-black">
        <a href={`/blog/${lowercaseSlug}/`} class="hover:text-primary transition">
          {title}
        </a>
      </h2>
      
      {description && (
        <p class="text-dark-2 mb-3 md:mb-4 line-clamp-3 md:line-clamp-4">{description}</p>
      )}
      
      <div class="flex items-center justify-between text-sm text-dark-2 mb-3 md:mb-4">
        <div class="flex items-center gap-2">
          {author?.image && (
            <img src={author.image} alt={author.name || 'Author'} class="w-8 h-8 rounded-full object-cover" />
          )}
          <span>{author?.name || 'Playable Data Team'}</span>
        </div>
        
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </div>
      
      <a href={`/blog/${lowercaseSlug}/`} class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-base font-medium rounded-md text-black bg-[#ffaa0c] hover:bg-opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#ffaa0c] w-full md:w-auto">
        Read Article
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</article>