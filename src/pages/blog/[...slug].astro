---
import Layout from '../../layouts/Layout.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { getArticles, getArticleById } from '../../utils/supabase';
import { marked } from 'marked';

export async function getStaticPaths() {
  try {
    // Get all articles from storage (using our updated function)
    const articles = await getArticles();
    
    if (!articles || articles.length === 0) {
      console.warn("No articles found, using placeholder");
      return [
        {
          params: { slug: 'placeholder' },
          props: { 
            article: {
              slug: 'placeholder',
              title: 'Welcome to Playable Data Blog',
              description: 'This is a placeholder article while we set up our content.',
              content: '# Welcome to Playable Data Blog\n\nWe\'re currently setting up our content. Please check back soon for articles on gaming analytics, data science, and more!',
              created_at: new Date().toISOString(),
              tags: ['welcome']
            } 
          }
        }
      ];
    }

    console.log(`Generating paths for ${articles.length} articles`);
    return articles.map(article => ({
      params: { slug: article.slug },
      props: { article },
    }));
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [
      {
        params: { slug: 'placeholder' },
        props: { 
          article: {
            slug: 'placeholder',
            title: 'Welcome to Playable Data Blog',
            description: 'This is a placeholder article while we set up our content.',
            content: '# Welcome to Playable Data Blog\n\nWe\'re currently setting up our content. Please check back soon for articles on gaming analytics, data science, and more!',
            created_at: new Date().toISOString(),
            tags: ['welcome']
          } 
        }
      }
    ];
  }
}

const { slug } = Astro.params;
// @ts-ignore - Temporarily ignore TypeScript checking for article props
const { article } = Astro.props;

// The content should already be HTML from our storage processing
const htmlContent = article?.content || '';

// Date handling
const pubDate = article.created_at || article.pubDate;
const updatedDate = article.updated_at || article.updatedDate;

// Special override for the Monetisation article
let authorName = 'Playable Data Team';
let authorImage = null;

if (article.slug && article.slug.includes('Mastering-Monetisation')) {
  console.log('*** APPLYING MONETISATION ARTICLE OVERRIDE ***');
  authorName = 'Anthon Fynn-Williams';
  authorImage = 'https://ganoqvjleaxfbcmzqaww.supabase.co/storage/v1/object/sign/media/SHZ06184.jpg?token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1cmwiOiJtZWRpYS9TSFowNjE4NC5qcGciLCJpYXQiOjE3NDE0NzYyMjAsImV4cCI6NDg5NTA3NjIyMH0.sUTi8l0v3B7JPnjDcapZGbnAFMfVxVadNDyZLJsGddQ';
} else if (article.author && typeof article.author === 'object' && article.author.name) {
  authorName = article.author.name;
  authorImage = article.author.image || null;
} else if (article.author_name) {
  authorName = article.author_name;
  authorImage = article.author_image || null;
}

// Debug output
console.log('Article slug:', article.slug);
console.log('Using author name:', authorName);
console.log('Using author image:', authorImage);

// @ts-ignore - Suppress TypeScript errors for article properties
---

<BlogPost post={{
  slug: article.slug,
  data: {
    title: article.title,
    description: article.description,
    pubDate: new Date(pubDate),
    updatedDate: updatedDate ? new Date(updatedDate) : undefined,
    coverImage: article.cover_image,
    author: {
      name: authorName,
      image: authorImage
    },
    tags: article.tags || []
  },
  body: article.content
}}>
  <!-- @ts-ignore -->
  <div set:html={htmlContent} />
</BlogPost>