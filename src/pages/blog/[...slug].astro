---
import Layout from '../../layouts/Layout.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { getArticles, getArticleById } from '../../utils/supabase';
import { marked } from 'marked';

export async function getStaticPaths() {
  try {
    // Get all articles from storage (using our updated function)
    const articles = await getArticles();
    
    if (!articles || articles.length === 0) {
      console.warn("No articles found, using placeholder");
      return [
        {
          params: { slug: 'placeholder' },
          props: { 
            article: {
              slug: 'placeholder',
              title: 'Welcome to Playable Data Blog',
              description: 'This is a placeholder article while we set up our content.',
              content: '# Welcome to Playable Data Blog\n\nWe\'re currently setting up our content. Please check back soon for articles on gaming analytics, data science, and more!',
              created_at: new Date().toISOString(),
              tags: ['welcome']
            } 
          }
        }
      ];
    }

    console.log(`Generating paths for ${articles.length} articles`);
    return articles.map(article => ({
      params: { slug: article.slug },
      props: { article },
    }));
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [
      {
        params: { slug: 'placeholder' },
        props: { 
          article: {
            slug: 'placeholder',
            title: 'Welcome to Playable Data Blog',
            description: 'This is a placeholder article while we set up our content.',
            content: '# Welcome to Playable Data Blog\n\nWe\'re currently setting up our content. Please check back soon for articles on gaming analytics, data science, and more!',
            created_at: new Date().toISOString(),
            tags: ['welcome']
          } 
        }
      }
    ];
  }
}

const { slug } = Astro.params;
// @ts-ignore - Temporarily ignore TypeScript checking for article props
const { article } = Astro.props;

// The content should already be HTML from our storage processing
const htmlContent = article?.content || '';

// Date handling
const pubDate = article.created_at || article.pubDate;
const updatedDate = article.updated_at || article.updatedDate;
---

<BlogPost post={{
  slug: article.slug,
  data: {
    title: article.title,
    description: article.description,
    pubDate: new Date(pubDate),
    updatedDate: updatedDate ? new Date(updatedDate) : undefined,
    coverImage: article.cover_image,
    author: {
      name: article.author?.name || article.author_name || 'Playable Data Team',
      image: article.author?.image || article.author_image
    },
    tags: article.tags || []
  },
  body: article.content
}}>
  <!-- @ts-ignore -->
  <div set:html={htmlContent} />
</BlogPost>