---
import Layout from '../../layouts/Layout.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { getArticles, getArticleById } from '../../utils/supabase';
import { marked } from 'marked';

export async function getStaticPaths() {
  try {
    console.log('Building blog post routes for static generation...');
    // Get all articles from storage (using our updated function)
    const articles = await getArticles();
    
    if (!articles || articles.length === 0) {
      console.warn("No articles found, using placeholder");
      return [
        {
          params: { slug: 'placeholder' },
          props: { 
            article: {
              slug: 'placeholder',
              title: 'Welcome to Playable Data',
              description: 'This is a placeholder article while we set up our content.',
              content: '# Welcome to Playable Data\n\nWe\'re currently setting up our content. Please check back soon for articles on gaming analytics, data science, and more!',
              created_at: new Date().toISOString(),
              tags: ['welcome']
            } 
          }
        }
      ];
    }

    console.log(`Generating paths for ${articles.length} articles`);
    
    // Make sure all articles have a valid slug
    const validArticles = articles.filter(article => {
      if (!article.slug) {
        console.warn(`Article with title "${article.title}" has no slug, skipping`);
        return false;
      }
      return true;
    });
    
    // Generate paths with lowercase slugs for consistency
    return validArticles.map(article => {
      // Ensure slug is lowercase and URI-safe for URL consistency
      const normalizedSlug = article.slug.toLowerCase().trim();
      console.log(`Generated route for: /blog/${normalizedSlug}/`);
      
      return {
        params: { slug: normalizedSlug },
        props: { article },
      };
    });
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [
      {
        params: { slug: 'placeholder' },
        props: { 
          article: {
            slug: 'placeholder',
            title: 'Welcome to Playable Data',
            description: 'This is a placeholder article while we set up our content.',
            content: '# Welcome to Playable Data\n\nWe\'re currently setting up our content. Please check back soon for articles on gaming analytics, data science, and more!',
            created_at: new Date().toISOString(),
            tags: ['welcome']
          } 
        }
      }
    ];
  }
}

// Get the slug from the URL params and ensure it's lowercase
const { slug } = Astro.params;
const normalizedSlug = slug ? slug.toLowerCase() : '';

// @ts-ignore - Temporarily ignore TypeScript checking for article props
const { article } = Astro.props;

// The content should already be HTML from our storage processing
const htmlContent = article?.content || '';

// Date handling with fallbacks for SEO consistency
const pubDate = new Date(article.created_at || article.pubDate || new Date());
const updatedDate = article.updated_at || article.updatedDate ? new Date(article.updated_at || article.updatedDate) : undefined;

// Prepare article metadata with fallbacks for SEO
const title = article.title || `Article - ${normalizedSlug}`;
const description = article.description || `Learn more about gaming analytics in this article from Playable Data.`;
const tags = article.tags || [];

// Special override for the Monetisation article
let authorName = 'Playable Data Team';
let authorImage = null;
let authorId = null;

if (article.slug && article.slug.includes('Mastering-Monetisation')) {
  console.log('*** APPLYING MONETISATION ARTICLE OVERRIDE ***');
  authorName = 'Anthon Fynn-Williams';
  authorId = 'pd-001';
  authorImage = 'https://ganoqvjleaxfbcmzqaww.supabase.co/storage/v1/object/sign/media/SHZ06184.jpg?token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1cmwiOiJtZWRpYS9TSFowNjE4NC5qcGciLCJpYXQiOjE3NDE0NzYyMjAsImV4cCI6NDg5NTA3NjIyMH0.sUTi8l0v3B7JPnjDcapZGbnAFMfVxVadNDyZLJsGddQ';
} else if (article.author_name && article.author_image) {
  // Prefer direct author_name and author_image fields if available
  authorName = article.author_name;
  authorId = article.author_id || null;
  authorImage = article.author_image;
  console.log('Found direct author_name/author_image:', authorName, authorImage);
} else if (article.author && typeof article.author === 'object' && article.author.name) {
  authorName = article.author.name;
  authorId = article.author.id || null;
  // Ensure we're using the image URL exactly as specified
  authorImage = article.author.image;
  console.log('Found author object with image:', authorImage);
} else if (typeof article.author === 'string') {
  authorName = article.author;
  console.log('Found string author name:', authorName);
}

// Cover image handling with fallback for SEO
const coverImage = article.cover_image || '/images/og-image.jpg';

// Debug output
console.log('Article slug:', article.slug);
console.log('Using author name:', authorName);
console.log('Using author ID:', authorId);
console.log('Using author image:', authorImage);
console.log('Using cover image:', coverImage);

// Extra verification for author image URL
if (authorImage && typeof authorImage === 'string' && authorImage.includes('://')) {
  console.log('Verified author image URL is preserved:', authorImage);
}

// @ts-ignore - Suppress TypeScript errors for article properties
---

<BlogPost post={{
  slug: article.slug,
  data: {
    title: title,
    description: description,
    pubDate: pubDate,
    updatedDate: updatedDate,
    coverImage: coverImage,
    author: {
      name: authorName,
      image: authorImage,
      id: authorId
    },
    tags: tags
  },
  body: article.content
}}>
  <!-- @ts-ignore -->
  <div set:html={htmlContent} />
</BlogPost>