---
import Layout from '../layouts/Layout.astro';
import { getArticles } from '../utils/supabase';
import { formatDate } from '../utils/date';
import FeaturedPost from '../components/FeaturedPost.astro';
import BlogCard from '../components/BlogCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

// Get all blog posts sorted by date
let allPosts = [];
try {
  allPosts = await getArticles();
  console.log(`Loaded ${allPosts.length} articles for the homepage`);
} catch (error) {
  console.error("Error fetching articles:", error);
  // Provide fallback data if database query fails
  allPosts = [];
}

// Sort posts by publication date (newest first)
const sortedPosts = allPosts
  .filter(post => post.status === 'published')
  .sort((a, b) => {
    // Use pubDate from markdown if available, otherwise fallback to created_at
    const dateA = a.pubDate ? new Date(a.pubDate) : new Date(a.created_at);
    const dateB = b.pubDate ? new Date(b.pubDate) : new Date(b.created_at);
    return dateB.valueOf() - dateA.valueOf();
  });

// First look for a post explicitly marked as featured
let featuredPost = sortedPosts.find(post => post.featured === true);

// If no post is explicitly marked as featured, use the most recent post
if (!featuredPost && sortedPosts.length > 0) {
  console.log('No explicitly featured post found, using most recent post');
  featuredPost = sortedPosts[0];
}

// Get remaining posts (skip the featured one)
const remainingPosts = featuredPost 
  ? sortedPosts.filter(post => post.id !== featuredPost.id)
  : sortedPosts;

// Get all unique topics and tags
const allTopics = [...new Set(allPosts.flatMap(post => post.topics || post.tags || []))].sort();

// Convert database articles to the format expected by components
function convertArticleToPost(article) {
  // Normalize author information
  let author = article.author;
  
  // If author is a string, convert to object
  if (typeof author === 'string') {
    author = { name: author };
  }
  // If author is missing, check for individual fields
  else if (!author) {
    author = {
      name: article.author_name || 'Playable Data Team',
      image: article.author_image
    };
  }
  // If author is an object but missing properties, add defaults
  else if (typeof author === 'object') {
    if (!author.name) {
      author.name = article.author_name || 'Playable Data Team';
    }
    if (!author.image && article.author_image) {
      author.image = article.author_image;
    }
  }
  
  console.log(`Converting article "${article.title}" - Author:`, JSON.stringify(author));
  
  return {
    slug: article.slug,
    data: {
      title: article.title,
      description: article.description,
      pubDate: article.pubDate ? new Date(article.pubDate) : new Date(article.created_at),
      updatedDate: article.updatedDate ? new Date(article.updatedDate) : 
                  article.updated_at ? new Date(article.updated_at) : undefined,
      coverImage: article.cover_image,
      author: author,
      topics: article.topics || article.tags || [],
      featured: article.featured
    }
  };
}
---

<Layout title="Playable Data Blog - Gaming Analytics Insights">
  <div class="bg-black text-white">
    <div class="container-custom py-16 md:py-20">
      <h1 class="text-4xl md:text-5xl font-bold">Playable Data Blog</h1>
      <p class="mt-4 text-xl text-accent-lighter max-w-3xl">
Join us as we break down industry trends, discuss strategies, and explore data-related topics tailored for the gaming world.

      </p>
    </div>
  </div>

  <div class="container-custom py-12">
    {featuredPost && (
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-black mb-8">Featured Article</h2>
        <FeaturedPost post={convertArticleToPost(featuredPost)} />
      </div>
    )}

    <div class="flex flex-col md:flex-row gap-8">
      <!-- Main content -->
      <div class="md:w-3/4">
        <h2 class="text-2xl font-bold text-black mb-8">Latest Articles</h2>
        {remainingPosts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {remainingPosts.map(post => (
              <BlogCard post={convertArticleToPost(post)} />
            ))}
          </div>
        ) : (
          <div class="bg-white p-8 rounded-lg shadow-md text-center">
            <p class="text-gray-600">No articles found. Check back soon for new content!</p>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="md:w-1/4">
        <div class="card sticky top-24">
          <h2 class="text-xl font-bold text-black mb-4">Topics</h2>
          {allTopics.length > 0 ? (
            <div class="flex flex-wrap gap-2">
              {allTopics.map(topic => (
                <a href={`/topics/${topic}/`} class="text-sm bg-tint-20 hover:bg-tint-50 text-dark-1 px-3 py-1 rounded-full transition mb-2">
                  #{topic}
                </a>
              ))}
            </div>
          ) : (
            <p class="text-gray-600">No topics found.</p>
          )}
        </div>
      </div>
    </div>
  </div>

  <NewsletterSignup />
</Layout>