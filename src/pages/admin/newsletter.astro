---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../db/supabase';
import { formatDate } from '../../utils/date';

// Check if user is authenticated
const isAuthenticated = Astro.request.headers.get('cookie')?.includes('supabase-auth-token=');

// Redirect if not authenticated
if (!isAuthenticated) {
  return Astro.redirect('/admin/login');
}

// Fetch newsletter signups from Supabase
let signups = [];
let error = null;

try {
  if (supabase) {
    const { data, error: fetchError } = await supabase
      .from('newsletter_signups')
      .select('*')
      .order('signup_date', { ascending: false });
    
    if (fetchError) throw fetchError;
    signups = data || [];
  } else {
    // Mock data for development when Supabase is not available
    signups = [
      {
        id: '1',
        email: 'test@example.com',
        signup_date: new Date().toISOString(),
        source: 'main_newsletter',
        page_url: 'https://playabledata.io/',
        is_active: true,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString()
      }
    ];
  }
} catch (e) {
  console.error('Error fetching newsletter signups:', e);
  error = e.message || 'An error occurred while fetching newsletter signups';
}

// Helper to format dates for display
function formatDisplayDate(dateString) {
  try {
    return formatDate(new Date(dateString));
  } catch (e) {
    return 'Invalid date';
  }
}

// Helper to format source name for display
function formatSource(source) {
  if (!source) return 'Unknown';
  
  return source
    .split('_')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

// Function to export CSV
const getCSVContent = () => {
  if (signups.length === 0) return '';
  
  // CSV header
  const headers = ['Email', 'Signup Date', 'Source', 'Page URL', 'Status'];
  const csvHeader = headers.join(',');
  
  // CSV rows
  const csvRows = signups.map(signup => {
    const date = new Date(signup.signup_date).toISOString().split('T')[0];
    const status = signup.is_active ? 'Active' : 'Inactive';
    
    return [
      `"${signup.email}"`,
      `"${date}"`,
      `"${signup.source || ''}"`,
      `"${signup.page_url || ''}"`,
      `"${status}"`
    ].join(',');
  });
  
  return [csvHeader, ...csvRows].join('\n');
};
---

<AdminLayout title="Newsletter Subscribers | Admin">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-900">Newsletter Subscribers</h1>
      <div>
        <button 
          id="export-csv" 
          class="btn btn-primary inline-flex items-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
          Export CSV
        </button>
      </div>
    </div>
    
    {error && (
      <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6" role="alert">
        <p>{error}</p>
      </div>
    )}
    
    {signups.length === 0 && !error ? (
      <div class="bg-blue-50 border-l-4 border-blue-500 text-blue-700 p-4">
        <p>No newsletter subscribers found.</p>
      </div>
    ) : (
      <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Email
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Date
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Source
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Status
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              {signups.map((signup) => (
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    {signup.email}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    {formatDisplayDate(signup.signup_date)}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    {formatSource(signup.source)}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <span class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${signup.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                      {signup.is_active ? 'Active' : 'Inactive'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

  <script is:inline define:vars={{ csvContent: getCSVContent() }}>
    document.addEventListener('DOMContentLoaded', function() {
      const exportButton = document.getElementById('export-csv');
      
      if (exportButton) {
        exportButton.addEventListener('click', function() {
          // CSV content is passed from the server
          const csvContent = csvContent;
          
          if (!csvContent) {
            alert('No data to export');
            return;
          }
          
          // Create a blob with the CSV content
          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          
          // Create a download link
          const link = document.createElement('a');
          const url = URL.createObjectURL(blob);
          
          link.setAttribute('href', url);
          link.setAttribute('download', `newsletter-subscribers-${new Date().toISOString().split('T')[0]}.csv`);
          link.style.display = 'none';
          
          document.body.appendChild(link);
          link.click();
          
          // Clean up
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        });
      }
    });
  </script>
</AdminLayout> 